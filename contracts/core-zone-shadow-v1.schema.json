{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge-console.core-zone-shadow.v1",
  "title": "MDOS Core Zone SHADOW Readiness Contract V1",
  "description": "Additive SHADOW-only contract. It MUST NOT mutate production recommendation, tradeability, Market Trust, DES, canonical selection or official efficacy.",
  "type": "object",
  "required": ["contract_version","engine","run_id","framework_version","calibration_version","run_role","report_hash","lineage","issuance","learning_policy"],
  "properties": {
    "contract_version": {"const":"CORE_ZONE_SHADOW_V1"},
    "engine": {"enum":["5DR","EDGE_STOCKS"]},
    "run_id": {"type":"string","minLength":1},
    "framework_version": {"type":"string","minLength":1},
    "calibration_version": {"type":"string","minLength":1},
    "run_role": {"const":"SHADOW"},
    "report_hash": {"type":"string","minLength":1},
    "lineage": {"type":"object","required":["source_run_id","source_report_hash","spec_version","issued_at","evidence_snapshot_id","production_isolated"],"properties":{"source_run_id":{"type":"string","minLength":1},"source_report_hash":{"type":"string","minLength":1},"spec_version":{"type":"string","minLength":1},"issued_at":{"type":"string","format":"date-time"},"evidence_snapshot_id":{"type":"string","minLength":1},"production_isolated":{"const":true}},"additionalProperties":true},
    "issuance": {"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","required":["horizon","target_session","expected_centre","core_low","core_high","core_width_points","core_width_pct","outer_low","outer_high","regime","evidence_snapshot_id","created_at","verification_state"],"properties":{"horizon":{"enum":["D","D+1","D+2","D+3","D+4","D+5"]},"target_session":{"type":"string","format":"date"},"expected_centre":{"type":"number"},"core_low":{"type":"number"},"core_high":{"type":"number"},"core_width_points":{"type":"number","minimum":0},"core_width_pct":{"type":"number","minimum":0},"outer_low":{"type":"number"},"outer_high":{"type":"number"},"regime":{"type":"string"},"evidence_snapshot_id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"verification_state":{"type":"string"}},"additionalProperties":true}},
    "evaluation": {"type":"array","items":{"type":"object","required":["horizon","target_session","outcome_source","session_open","session_high","session_low","session_close","core_interaction","core_close_hit","outer_interaction","outer_close_hit","centre_error","normalized_centre_error","miss_distance","width_normalized_miss","direction_hit","direction_zone_hit","scorable","evaluated_at"],"properties":{"horizon":{"enum":["D","D+1","D+2","D+3","D+4","D+5"]},"target_session":{"type":"string","format":"date"},"outcome_source":{"type":"string","minLength":1},"session_open":{"type":"number"},"session_high":{"type":"number"},"session_low":{"type":"number"},"session_close":{"type":"number"},"core_interaction":{"enum":["FULL_DEEP","CORE_PARTIAL","EDGE","NEAR_MISS","MISS"]},"core_close_hit":{"type":"boolean"},"outer_interaction":{"type":"boolean"},"outer_close_hit":{"type":"boolean"},"centre_error":{"type":"number","minimum":0},"normalized_centre_error":{"type":"number","minimum":0},"miss_distance":{"type":"number","minimum":0},"width_normalized_miss":{"type":"number","minimum":0},"direction_hit":{"type":"boolean"},"direction_zone_hit":{"type":"boolean"},"scorable":{"type":"boolean"},"evaluated_at":{"type":"string","format":"date-time"}},"additionalProperties":true}},
    "learning_policy":{"type":"object","required":["automatic_observation","automatic_promotion","user_decision_required"],"properties":{"automatic_observation":{"const":true},"automatic_promotion":{"const":false},"user_decision_required":{"const":"APPROVE_REJECT_DEFER"}},"additionalProperties":false}
  },
  "allOf": [
    {"if":{"properties":{"engine":{"const":"5DR"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+1"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"5DR"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+2"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"5DR"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+3"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"5DR"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+4"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"5DR"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+5"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"EDGE_STOCKS"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"EDGE_STOCKS"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+1"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"EDGE_STOCKS"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+2"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"EDGE_STOCKS"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+3"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}},
    {"if":{"properties":{"engine":{"const":"EDGE_STOCKS"}},"required":["engine"]},"then":{"properties":{"issuance":{"contains":{"properties":{"horizon":{"const":"D+4"}},"required":["horizon"]},"minContains":1,"maxContains":1}}}}
  ],
  "additionalProperties":true
}
