{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge-console.edge-stocks-output.v1.3",
  "title": "EDGE Stocks Output Contract V1.3 / Efficacy V2",
  "type": "object",
  "required": [
    "contract_version",
    "presentation_contract",
    "engine",
    "framework_version",
    "ticker",
    "run_id",
    "generated_at",
    "presentation",
    "master_assessment",
    "active_calls",
    "current_stock_outcome",
    "drilldown"
  ],
  "properties": {
    "contract_version": {
      "const": "EDGE_STOCKS_V1_3"
    },
    "presentation_contract": {
      "const": "EFFICACY_V2"
    },
    "engine": {
      "const": "EDGE_STOCKS"
    },
    "framework_version": {
      "const": "EDGE_V1"
    },
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "presentation": {
      "type": "object",
      "required": [
        "standard_table_count",
        "table_1",
        "table_2",
        "table_3",
        "table_4"
      ],
      "properties": {
        "standard_table_count": {
          "const": 4
        },
        "table_1": {
          "const": "EDGE_MASTER_ASSESSMENT"
        },
        "table_2": {
          "const": "ACTIVE_CALLS"
        },
        "table_3": {
          "const": "CURRENT_STOCK_OUTCOME"
        },
        "table_4": {
          "const": "DRILLDOWN"
        }
      },
      "additionalProperties": false
    },
    "master_assessment": {
      "type": "object"
    },
    "active_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "recommendation_id",
          "definitive_forecast",
          "definitive_recommendation",
          "expected_price_zone",
          "probabilities"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_id": {
            "type": "string",
            "minLength": 1
          },
          "definitive_forecast": {
            "type": "string",
            "minLength": 1
          },
          "definitive_recommendation": {
            "type": "string",
            "minLength": 1
          },
          "expected_price_zone": {
            "type": "object",
            "required": [
              "low",
              "high"
            ]
          },
          "probabilities": {
            "type": "object",
            "required": [
              "bull",
              "base",
              "bear"
            ]
          }
        }
      }
    },
    "current_stock_outcome": {
      "type": "object",
      "required": [
        "des",
        "market_trust",
        "directional_agreement",
        "effective_conviction",
        "probabilities",
        "definitive_forecast",
        "expected_price_zone",
        "forecast_horizon",
        "risk_override",
        "primary_action",
        "decision_ladder",
        "bot",
        "execution"
      ],
      "properties": {
        "des": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "market_trust": {
          "type": "object",
          "required": [
            "score",
            "band",
            "subscores",
            "weights"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "band": {
              "type": "string",
              "minLength": 1
            },
            "subscores": {
              "type": "object",
              "required": [
                "evidence_quality",
                "freshness",
                "completeness",
                "directional_agreement",
                "market_confirmation"
              ]
            },
            "weights": {
              "type": "object",
              "required": [
                "evidence_quality",
                "freshness",
                "completeness",
                "directional_agreement",
                "market_confirmation"
              ]
            }
          }
        },
        "directional_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "effective_conviction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probabilities": {
          "type": "object",
          "required": [
            "bull",
            "base",
            "bear"
          ]
        },
        "definitive_forecast": {
          "type": "string",
          "minLength": 1
        },
        "expected_price_zone": {
          "type": "object",
          "required": [
            "low",
            "high"
          ]
        },
        "forecast_horizon": {
          "type": "string",
          "minLength": 1
        },
        "risk_override": {
          "type": "object",
          "required": [
            "status"
          ]
        },
        "primary_action": {
          "type": "string",
          "minLength": 1
        },
        "decision_ladder": {
          "type": "string",
          "minLength": 1
        },
        "bot": {
          "type": "object",
          "required": [
            "score",
            "grade",
            "subscores",
            "weights"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "grade": {
              "type": "string",
              "minLength": 1
            },
            "subscores": {
              "type": "object",
              "required": [
                "forecast_edge",
                "market_trust",
                "structure_pattern_quality",
                "pv_pvpo_confirmation",
                "catalyst_asymmetry",
                "execution_quality"
              ]
            },
            "weights": {
              "type": "object",
              "required": [
                "forecast_edge",
                "market_trust",
                "structure_pattern_quality",
                "pv_pvpo_confirmation",
                "catalyst_asymmetry",
                "execution_quality"
              ]
            }
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "instrument",
            "execution_quality_score"
          ]
        }
      }
    },
    "drilldown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "score_or_level",
          "verification_status",
          "key_outcome",
          "interpretation",
          "original_weight",
          "normalized_weight",
          "weighted_contribution",
          "evidence_quality",
          "conflict_flag",
          "finding"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "score_or_level": {},
          "verification_status": {
            "enum": [
              "VERIFIED",
              "NOT_VERIFIED",
              "NOT_AVAILABLE",
              "NOT_SCORABLE",
              "N/A"
            ]
          },
          "key_outcome": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "original_weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "normalized_direction": {
            "type": [
              "number",
              "null"
            ]
          },
          "normalized_weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "weighted_contribution": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence_quality": {},
          "conflict_flag": {
            "type": "boolean"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
