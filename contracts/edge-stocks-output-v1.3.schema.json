{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge-console.edge-stocks-output.v1.3",
  "title": "EDGE Stocks Output Contract V1.3 / Efficacy V2",
  "type": "object",
  "required": [
    "contract_version",
    "presentation_contract",
    "engine",
    "framework_version",
    "ticker",
    "run_id",
    "generated_at",
    "presentation",
    "master_assessment",
    "active_calls",
    "current_stock_outcome",
    "drilldown"
  ],
  "properties": {
    "contract_version": {
      "const": "EDGE_STOCKS_V1_3"
    },
    "presentation_contract": {
      "const": "EFFICACY_V2"
    },
    "engine": {
      "const": "EDGE_STOCKS"
    },
    "framework_version": {
      "const": "EDGE_V1"
    },
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "presentation": {
      "type": "object",
      "required": [
        "standard_table_count",
        "table_1",
        "table_2",
        "table_3",
        "table_4"
      ],
      "properties": {
        "standard_table_count": {
          "const": 4
        },
        "table_1": {
          "const": "EDGE_MASTER_ASSESSMENT"
        },
        "table_2": {
          "const": "ACTIVE_CALLS"
        },
        "table_3": {
          "const": "CURRENT_STOCK_OUTCOME"
        },
        "table_4": {
          "const": "DRILLDOWN"
        }
      },
      "additionalProperties": false
    },
    "master_assessment": {
      "type": "object"
    },
    "active_calls": {
      "type": "array"
    },
    "current_stock_outcome": {
      "type": "object",
      "required": [
        "des",
        "market_trust",
        "directional_agreement",
        "effective_conviction",
        "probabilities",
        "definitive_forecast",
        "expected_price_zone",
        "forecast_horizon",
        "risk_override",
        "primary_action",
        "decision_ladder",
        "bot",
        "execution"
      ],
      "properties": {
        "market_trust": {
          "type": "object",
          "required": [
            "score",
            "band",
            "subscores"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "band": {
              "type": "string",
              "minLength": 1
            },
            "subscores": {
              "type": "object",
              "required": [
                "evidence_quality",
                "freshness",
                "completeness",
                "directional_agreement",
                "market_confirmation"
              ],
              "properties": {
                "evidence_quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "freshness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "completeness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "directional_agreement": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "market_confirmation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "bot": {
          "type": "object",
          "required": [
            "score",
            "grade",
            "subscores"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "grade": {
              "enum": [
                "C",
                "B",
                "A",
                "A+",
                "A++"
              ]
            },
            "subscores": {
              "type": "object",
              "required": [
                "forecast_edge",
                "market_trust",
                "structure_pattern_quality",
                "pv_pvpo_confirmation",
                "catalyst_asymmetry",
                "execution_quality"
              ],
              "properties": {
                "forecast_edge": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "market_trust": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "structure_pattern_quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "pv_pvpo_confirmation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "catalyst_asymmetry": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "execution_quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      }
    },
    "drilldown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "score_or_level",
          "original_weight",
          "normalized_direction",
          "normalized_weight",
          "weighted_contribution",
          "evidence_quality",
          "verification_status",
          "conflict_flag",
          "key_outcome",
          "interpretation"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "score_or_level": {},
          "verification_status": {
            "enum": [
              "VERIFIED",
              "NOT_VERIFIED",
              "NOT_AVAILABLE",
              "NOT_SCORABLE",
              "N/A"
            ]
          },
          "key_outcome": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "original_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "normalized_direction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1,
            "maximum": 1
          },
          "normalized_weight": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "weighted_contribution": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -100,
            "maximum": 100
          },
          "evidence_quality": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "NOT_VERIFIED"
            ]
          },
          "conflict_flag": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
