{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edge-console.edge-stocks-output.v1.3",
  "title": "EDGE Stocks Output Contract V1.3 / Efficacy V2",
  "type": "object",
  "required": ["contract_version","presentation_contract","engine","framework_version","ticker","run_id","generated_at","presentation","master_assessment","active_calls","current_stock_outcome","drilldown"],
  "properties": {
    "contract_version": {"const":"EDGE_STOCKS_V1_3"},
    "presentation_contract": {"const":"EFFICACY_V2"},
    "engine": {"const":"EDGE_STOCKS"},
    "framework_version": {"const":"EDGE_V1"},
    "ticker": {"type":"string","minLength":1},
    "run_id": {"type":"string","minLength":1},
    "generated_at": {"type":"string","format":"date-time"},
    "presentation": {"type":"object","required":["standard_table_count","table_1","table_2","table_3","table_4"],"properties":{"standard_table_count":{"const":4},"table_1":{"const":"EDGE_MASTER_ASSESSMENT"},"table_2":{"const":"ACTIVE_CALLS"},"table_3":{"const":"CURRENT_STOCK_OUTCOME"},"table_4":{"const":"DRILLDOWN"}},"additionalProperties":false},
    "master_assessment": {"type":"object"},
    "active_calls": {"type":"array","items":{"type":"object","required":["ticker","recommendation_id","definitive_forecast","definitive_recommendation","expected_price_zone","probabilities"],"properties":{"ticker":{"type":"string","minLength":1},"recommendation_id":{"type":"string","minLength":1},"definitive_forecast":{"type":"string","minLength":1},"definitive_recommendation":{"type":"string","minLength":1},"expected_price_zone":{"type":"object","required":["low","high"]},"probabilities":{"type":"object","required":["bull","base","bear"]}}}},
    "current_stock_outcome": {
      "type":"object",
      "required":["des","market_trust","directional_agreement","effective_conviction","probabilities","definitive_forecast","expected_price_zone","forecast_horizon","forecast_sessions","risk_override","primary_action","decision_ladder","bot","execution"],
      "properties":{
        "des":{"type":"number","minimum":-100,"maximum":100},
        "market_trust":{"type":"object","required":["score","band","subscores","weights"]},
        "directional_agreement":{"type":"number","minimum":0,"maximum":100},
        "effective_conviction":{"type":"number","minimum":0,"maximum":1},
        "probabilities":{"type":"object","required":["bull","base","bear"]},
        "definitive_forecast":{"type":"string","minLength":1},
        "expected_price_zone":{"type":"object","required":["low","high"]},
        "forecast_horizon":{"const":"D:D+4"},
        "forecast_sessions":{
          "type":"array","minItems":5,"maxItems":5,
          "prefixItems":[
            {"$ref":"#/$defs/d"},{"$ref":"#/$defs/d1"},{"$ref":"#/$defs/d2"},{"$ref":"#/$defs/d3"},{"$ref":"#/$defs/d4"}
          ],"items":false
        },
        "risk_override":{"type":"object","required":["status"]},
        "primary_action":{"type":"string","minLength":1},
        "decision_ladder":{"type":"string","minLength":1},
        "bot":{"type":"object","required":["score","grade","subscores","weights"]},
        "execution":{"type":"object","required":["instrument","execution_quality_score"]}
      }
    },
    "drilldown":{"type":"array","minItems":1,"items":{"type":"object","required":["component","score_or_level","verification_status","key_outcome","interpretation","original_weight","normalized_weight","weighted_contribution","evidence_quality","conflict_flag","finding"]}}
  },
  "$defs":{
    "sessionBase":{"type":"object","required":["session_label","trading_date","direction","expected_zone"],"properties":{"trading_date":{"type":"string","format":"date"},"direction":{"type":"string","minLength":1},"expected_zone":{"type":"object","required":["low","high"]},"confidence":{"type":["number","null"]},"probability":{"type":["number","null"]}},"additionalProperties":true},
    "d":{"allOf":[{"$ref":"#/$defs/sessionBase"},{"properties":{"session_label":{"const":"D"}}}]},
    "d1":{"allOf":[{"$ref":"#/$defs/sessionBase"},{"properties":{"session_label":{"const":"D+1"}}}]},
    "d2":{"allOf":[{"$ref":"#/$defs/sessionBase"},{"properties":{"session_label":{"const":"D+2"}}}]},
    "d3":{"allOf":[{"$ref":"#/$defs/sessionBase"},{"properties":{"session_label":{"const":"D+3"}}}]},
    "d4":{"allOf":[{"$ref":"#/$defs/sessionBase"},{"properties":{"session_label":{"const":"D+4"}}}]}
  },
  "additionalProperties":true
}
