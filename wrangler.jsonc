{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-console",
  "main": "src/production-entry.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "edge-console-evidence"
    }
  ],
  "triggers": {
    "crons": [
      "20 3 * * 1-5",
      "35-39 3 * * 1-5",
      "40-44 3 * * 1-5",
      "7,22,37,52 * * * 1-5"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "ACCESS_IDENTITY_MODE": "AUDIT",
    "OUTPUT_CONTRACT_VERSION": "1.0",
    "FIVEDR_REPOSITORY": "kanirudhsaxena-code/EDGE---V1",
    "FIVEDR_ACQUIRE_WORKFLOW": "5dr-console-acquire-proxy.yml",
    "FIVEDR_PREOPEN_ACQUIRE_WORKFLOW": "5dr-console-preopen-acquire-proxy.yml",
    "FIVEDR_ASSESSMENT_REPOSITORY": "kanirudhsaxena-code/5DR-V2",
    "FIVEDR_ASSESSMENT_WORKFLOW": "assessment-refresh.yml",
    "FIVEDR_WORKFLOW": "5dr-console-execute-proxy.yml",
    "FIVEDR_CALLBACK_URL": "https://edge-console.k-anirudhsaxena.workers.dev"
  }
}
