{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-console",
  "main": "src/mobile-v1-entry.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "edge-console-evidence"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "ACCESS_IDENTITY_MODE": "AUDIT",
    "OUTPUT_CONTRACT_VERSION": "1.0",
    "FIVEDR_REPOSITORY": "kanirudhsaxena-code/EDGE---V1",
    "FIVEDR_ACQUIRE_WORKFLOW": "5dr-console-acquire-proxy.yml",
    "FIVEDR_WORKFLOW": "5dr-console-execute-proxy.yml",
    "FIVEDR_CALLBACK_URL": "https://edge-console.k-anirudhsaxena.workers.dev"
  }
}
