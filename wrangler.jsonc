{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-console",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "edge-console-evidence"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "OUTPUT_CONTRACT_VERSION": "1.0"
  }
}
