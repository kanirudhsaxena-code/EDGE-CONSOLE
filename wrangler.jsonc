{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development",
    "OUTPUT_CONTRACT_VERSION": "1.0"
  }
}
